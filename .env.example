# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=admin/

# Frontend URL used in verification and password-reset emails
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Email (Brevo recommended on Render) ----
# BREVO_API_KEY=xkeysib-...
# Without a provider, emails print in the terminal while DEBUG=True.
DEFAULT_FROM_EMAIL=YasTalk <Info@yastalk.com>
CONTACT_EMAIL=Info@yastalk.com

# ---- Plans ----
SUBSCRIPTION_DAYS=30
# Premium is shown as $4.99 and charged in KSh at checkout.
PREMIUM_PRICE_USD=4.99
PREMIUM_PRICE_KES=650

# ---- IntaSend (plan checkout: M-Pesa, card, bank transfer) ----
# Dashboard -> Settings -> API keys. The publishable key starts with ISPubKey_,
# the secret key with ISSecretKey_. Payouts go to the bank account connected
# under IntaSend -> Wallet / Payouts.
INTAASEND_PUBLISHABLE_KEY=
INTAASEND_SECRET_KEY=
# Webhook page: https://your-backend.example.com/api/payments/intasend/webhook/
# Type any long random string in IntaSend's "challenge" field and put the same
# string here. Every callback is checked against it.
INTAASEND_WEBHOOK_CHALLENGE=
INTAASEND_API_BASE=https://api.intasend.com

# ---- M-Pesa (Daraja) ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-backend.example.com/api/payments/mpesa/callback/your-secret/
MPESA_CALLBACK_SECRET=your-secret

# ---- Donations ----
PAYSTACK_SECRET_KEY=
DONATION_BEP20_ADDRESS=
DONATION_CRYPTO_TOKENS=USDT,USDC,BUSD
DONATION_PAYBILL=
DONATION_PAYBILL_ACCOUNT=

# ---- Bank transfer (donations) ----
# The bank section appears on the donate page only once an account number is set.
DONATION_BANK_NAME=
DONATION_BANK_ACCOUNT_NAME=
DONATION_BANK_ACCOUNT_NUMBER=
DONATION_BANK_BRANCH=
DONATION_BANK_SWIFT=
