DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email (Brevo HTTPS API; needed on Render because it blocks SMTP)
# Leave BREVO_API_KEY empty locally and emails are printed in the terminal.
BREVO_API_KEY=
# Must be a sender you verified in Brevo -> Senders, domains & dedicated IPs
DEFAULT_FROM_EMAIL=YasTalk <your-verified-sender@example.com>

# Optional hardening
# ADMIN_URL=choose-a-private-path/
# NUM_PROXIES=
# HSTS_SECONDS=31536000

# M-Pesa (Safaricom Daraja). Start in sandbox, switch to production after go-live.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test values are on the Daraja portal. Production: your own Paybill/Till and passkey.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Long random string. It becomes part of the callback URL so strangers cannot fake a payment.
MPESA_CALLBACK_SECRET=
# Must be public HTTPS (not localhost), ending with the same secret:
# https://yas-talk.onrender.com/api/payments/mpesa/callback/<MPESA_CALLBACK_SECRET>/
MPESA_CALLBACK_URL=

# Donations (all optional: a way of giving only appears on the site when its setting is filled in)
# Card payments: create a Paystack account (Kenya), then paste the SECRET key (sk_live_... / sk_test_...)
PAYSTACK_SECRET_KEY=
# In Paystack > Settings > API Keys & Webhooks set the webhook URL to:
#   https://yas-talk.onrender.com/api/donations/paystack/webhook/
# Paybill (once Safaricom gives you one):
DONATION_PAYBILL=
DONATION_PAYBILL_ACCOUNT=YASTALK
# Crypto: your BNB Smart Chain (BEP-20) address, starts with 0x and is 42 characters long
DONATION_BEP20_ADDRESS=
DONATION_CRYPTO_TOKENS=USDT,USDC,BNB

# Days of access one successful plan payment buys
SUBSCRIPTION_DAYS=30
